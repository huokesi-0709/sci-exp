{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline emergency protocol chunk",
  "type": "object",
  "required": ["evidence_id", "text", "source_org", "authority_level", "hazard_types", "status"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "source_org": {"type": "string", "minLength": 1},
    "source_id": {"type": "string"},
    "title": {"type": "string"},
    "source_url": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "target_population": {"type": "string"},
    "version": {"type": "string"},
    "effective_date": {"type": "string"},
    "expiry_date": {"type": "string"},
    "authority_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "hazard_types": {"type": "array", "items": {"type": "string"}},
    "applicability": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["current", "expired", "superseded", "draft", "demo"]},
    "status_detail": {"type": "string"},
    "source_tier": {"type": "string"},
    "content_review_status": {"type": "string"},
    "license_status": {"type": "string"},
    "redistribution_status": {"type": "string"},
    "file_sha256": {"type": "string"},
    "parent_source_id": {"type": "string"},
    "parent_file_sha256": {"type": "string"},
    "source_locator": {"type": "string"},
    "derivation_method": {"type": "string"},
    "derivation_rule_reason": {"type": "string"}
  },
  "additionalProperties": true
}
